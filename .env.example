# 공공데이터포털 — 대구 교통소통정보(신)
# https://www.data.go.kr/data/15126266/openapi.do
# (온라인 시연·관제용. 안심구역 학습 단계에서는 필요 없음)
DAEGU_TRAFFIC_API_KEY=
DAEGU_TRAFFIC_API_URL=https://apis.data.go.kr/6270000/service/rest1/linkspeed

# 경로 엔진
#   graph = 표준노드링크 DiGraph (안심구역 학습·오프라인 기본)
#   osrm  = OSM driving (온라인 시연 보강. 공개 데모 URL 또는 로컬 backend)
ROUTING_ENGINE=graph
# 온라인 시연 예:
# ROUTING_ENGINE=osrm
# OSRM_URL=https://router.project-osrm.org/route/v1/driving
# 로컬 backend 예:
# OSRM_URL=http://127.0.0.1:5000/route/v1/driving
